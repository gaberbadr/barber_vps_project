# ==============================================================================
# PRODUCTION DATABASE (Blitz.cloud Managed PostgreSQL - REQUIRED IN PRODUCTION)
# ==============================================================================
# Blitz.cloud automatically injects DATABASE_URL when you connect your Blitz Managed
# PostgreSQL database (e.g., 'barberDB') to the application via the Blitz dashboard.
# Alternatively, supply it via Blitz Dashboard -> Settings -> Environment Variables.
# FORMAT: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ==============================================================================
# LOCAL DEVELOPMENT ONLY (Docker Compose / Local PostgreSQL)
# ==============================================================================
# These settings are used ONLY for local workstation development with docker-compose.
# Do NOT configure these in the Blitz.cloud production environment.
DB_PASSWORD=your_local_dev_password_here
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=barberdb_dev;Username=postgres;Password=your_local_dev_password_here

# Redis / Distributed Cache Configuration
# Option A (External Upstash Redis with TLS - Recommended):
# REDIS_URL=rediss://default:your_upstash_token@your_cluster.upstash.io:6379
# Option B (Blitz Managed Redis / Valkey 8):
# Connect a Blitz Managed Redis database to the app. Blitz automatically injects REDIS_URL.
# Option C (Local Development / Self-hosted Redis):
# REDIS_URL=redis://localhost:6379
REDIS_URL=rediss://default:your_upstash_token@your_cluster.upstash.io:6379

# Cache Settings
CacheSettings__Redis__Enabled=true
CacheSettings__Redis__DefaultExpirationMinutes=1
CacheSettings__Redis__ConnectTimeoutMs=10000
CacheSettings__Redis__SyncTimeoutMs=10000

# Rate Limiting
RateLimiting__Authenticated__Requests=100
RateLimiting__Authenticated__WindowSeconds=60
RateLimiting__Anonymous__Requests=30
RateLimiting__Anonymous__WindowSeconds=60
RateLimiting__Global__Requests=1000
RateLimiting__Global__WindowSeconds=60
RateLimiting__ExcludedPaths__0=/health
RateLimiting__ExcludedPaths__1=/swagger
RateLimiting__ExcludedPaths__2=/.well-known
RateLimiting__ExcludedPaths__3=/metrics
RateLimiting__ClientIdCookieName=X-Client-Id
RateLimiting__ClientIdCookieExpirationDays=30

# Login Rate Limiter
LoginRateLimiter__MaxAttempts=5
LoginRateLimiter__AttemptWindowMinutes=15
LoginRateLimiter__BanDurationHours=3

# JWT
JWT__Key=your_secret_here
JWT__Issuer=https://barber.devs.surf/api
JWT__Audience=project1
JWT__AccessTokenExpirationMinutes=15
JWT__RefreshTokenExpirationDays=7

# Email
Email__Host=smtp.gmail.com
Email__Port=587
Email__SmtpUsername=your_email@gmail.com
Email__SmtpPassword=your_email_password
Email__SenderEmail=your_email@gmail.com
Email__SenderDisplayName=Your Company
Email__EnableSsl=true
Email__ExpirationMinutes=720

# Google Auth
Authentication__Google__ClientId=your_google_client_id
Authentication__Google__ClientSecret=your_google_client_secret

# URLs
BaseURL=https://barber.devs.surf/api
Frontend__AllowedBaseUrls__0=http://barber.devs.surf
Frontend__AllowedBaseUrls__1=https://barber.devs.surf

# Domain & Routing
DOMAIN=barber.devs.surf

# pgAdmin 4 Administration (Database Management)
PGADMIN_DEFAULT_EMAIL=admin@barber.local
PGADMIN_DEFAULT_PASSWORD=your_strong_pgadmin_password_here
# Optional: Nginx HTTP Basic Auth layer (defaults to PGADMIN_DEFAULT_EMAIL and PGADMIN_DEFAULT_PASSWORD if omitted)
PGADMIN_BASIC_AUTH_USER=admin
PGADMIN_BASIC_AUTH_PASSWORD=your_strong_pgadmin_password_here
